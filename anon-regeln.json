    "versionKontext": [
      "(?i)\\b(?:version|ver|release|build|os10|aos-cx|aos-s|sonic|comware|routeros|firmware|image|software|sw-version|nos|nx-os|ios|fortios|sfos)[ \\t]*[:=]?[ \\t]*v?\\d+(?:\\.\\d+){1,4}(?:[-._a-zA-Z0-9]+)?",
      "(?i)\\b(?:FL|KB|WC|YA|YB|WB|YC|PL|TL)\\.\\d{1,2}\\.\\d{1,2}\\.\\d{4}\\b",
      "\\b\\d{1,3}\\.\\d{1,3}\\.(?:25[6-9]|2[6-9]\\d|[3-9]\\d{2}|\\d{4,})(?:\\.\\d+)?\\b"
    ],
    "musterRegex": [
      "(?i)\\b(?:(?:Ethernet|GigabitEthernet|TenGigabitEthernet|TwentyFiveGigE|Twenty-FiveGigE|FortyGigE|HundredGigE|M-GigabitEthernet|Bridge-Aggregation|Route-Aggregation|Vlan-interface|Port-Channel|PortChannel|Vlan|Loopback|Tunnel|Mgmt|Management|sfp-sfpplus|qsfpplus|pppoe-out|combo|ether|wlan|sfp|lag|eth|xe-|ge-|et-|po|Gi|Te|Fa|Fo|Hu|XGE|FGE|GE)\\d+(?:[/:.-]\\d+)*|(?:bridge|bonding)\\d*)\\b",
      "(?<![0-9A-Fa-f:])\\d{1,2}:\\d{2}:\\d{2}(?:[.,]\\d{1,6})?(?:[ \\t]*(?:UTC|CET|CEST|MESZ|MEZ|Z|[+-]\\d{2}:?\\d{2}))?(?![0-9A-Fa-f:])",
      "\\b(?:255\\.255\\.255\\.(?:0|128|192|224|240|248|252|254|255)|255\\.255\\.(?:0|128|192|224|240|248|252|254|255)\\.0|255\\.(?:0|128|192|224|240|248|252|254|255)\\.0\\.0|0\\.0\\.0\\.0|255\\.255\\.255\\.255)\\b",
      "(?im)^[ \\t]*board-name[ \\t]*[:=][ \\t]*[^\\r\\n]+(?=\\r?$)"
    ]
  },
  "pruefung": {
    "erlaubtListe": [
      "0.0.0.0",
